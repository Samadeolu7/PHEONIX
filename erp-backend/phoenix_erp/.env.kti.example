# ============================================================
#  Phoenix KTI — Production Environment Variables
#  Copy this to /opt/phoenix-kti/.env on the server
#  Do NOT commit the real .env to git.
# ============================================================

# ── Django ────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=erp.krystartrust.ng,api.kti.krystartrust.ng,flower.kti.krystartrust.ng

# ── Database ──────────────────────────────────────────────────
DB_NAME=phoenix_kti_db
DB_USER=phoenix_kti
DB_PASSWORD=strong-password-here
# DB_HOST and DB_PORT are set inside docker-compose (host=postgres, port=5432)

# ── Redis / Celery ────────────────────────────────────────────
CELERY_BROKER_URL=redis://phoenix_kti_redis:6379/0
CELERY_RESULT_BACKEND=redis://phoenix_kti_redis:6379/0

# ── Email ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@krystartrust.ng

# ── CORS (override if needed) ─────────────────────────────────
CORS_ALLOWED_ORIGINS=https://erp.krystartrust.ng,https://api.kti.krystartrust.ng

# ── Docker images (override to pin a specific SHA) ────────────
DOCKER_IMAGE_BACKEND=samadeolu7/phoenix-kti-backend:latest
DOCKER_IMAGE_FRONTEND=samadeolu7/phoenix-kti-frontend:latest

# ── Bank-Recon (Java) ───────────────────────────────────────────
# bank-recon is a separate compose stack (see java-apps/Bank-Recon/docker-compose.yml)
# joining this same phoenix_kti_backend network — reachable by service name,
# never exposed on a host port. INTERNAL_SERVICE_TOKEN must be the EXACT same
# value as DJANGO_INTERNAL_SERVICE_TOKEN in Bank-Recon's own .env — see
# java-apps/Bank-Recon/scripts/rotate-token.sh to generate/rotate it.
BANK_RECON_SERVICE_URL=http://bank-recon:8081
INTERNAL_SERVICE_TOKEN=generate-with-rotate-token.sh
