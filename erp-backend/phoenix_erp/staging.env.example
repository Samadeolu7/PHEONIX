# ─────────────────────────────────────────────────────────────────────────────
# Phoenix ERP — STAGING .env template
#
# Copy to /opt/phoenix-kti-staging/.env on the server (NOT into git), then fill
# in every value marked CHANGE-ME. Full steps: docs/STAGING.md.
#
# Every name below that also exists in production MUST differ from
# production's value. The deploy workflow refuses to start staging if the
# project, containers, network, database volume or image tags resolve to
# production's.
# ─────────────────────────────────────────────────────────────────────────────

# ── Compose: which files, and isolation from production ─────────────────────
COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml
STACK_PROJECT_NAME=phoenix_kti_staging
STACK_CONTAINER_PREFIX=phoenix_kti_staging
BACKEND_NETWORK_NAME=phoenix_kti_staging_backend
# Created by the deploy workflow if missing (docker volume create ...).
PG_VOLUME_NAME=phoenix-kti-staging_pg_data

# ── Images: always the :staging tag, never :latest ──────────────────────────
DOCKER_IMAGE_BACKEND=samadeolu7/phoenix-kti-backend:staging
DOCKER_IMAGE_FRONTEND=samadeolu7/phoenix-kti-frontend:staging

# ── Traefik routes (names must not match production's) ──────────────────────
TRAEFIK_PREFIX=phoenix-kti-staging
TRAEFIK_MIDDLEWARE_PREFIX=kti-staging
FRONTEND_HOST=staging.krystartrust.ng
API_HOST=api.staging.krystartrust.ng
# Flower is not started on staging; this only keeps its route name unique.
FLOWER_HOST=flower.staging.krystartrust.ng

# Smaller footprint than production (same server).
CELERY_CONCURRENCY=1

# ── Django ──────────────────────────────────────────────────────────────────
# Generate a NEW key, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE-ME-new-random-secret-not-production
DEBUG=False
ALLOWED_HOSTS=staging.krystartrust.ng,api.staging.krystartrust.ng
CORS_ALLOWED_ORIGINS=https://staging.krystartrust.ng
PORTAL_FRONTEND_URL=https://staging.krystartrust.ng

# ── Database (its own name, user and password) ──────────────────────────────
DB_NAME=phoenix_staging
DB_USER=phoenix_staging
# Generate a NEW password, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=CHANGE-ME-new-random-password

# ── Redis / Celery (staging's own redis container) ──────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Email ───────────────────────────────────────────────────────────────────
# STAGING=true is set by docker-compose.staging.yml. With it on:
#   - STAGING_EMAIL_REDIRECT empty  -> every email is only PRINTED to the
#     backend log (docker compose logs backend). Nothing is delivered.
#   - STAGING_EMAIL_REDIRECT set    -> every email is re-addressed to that ONE
#     inbox (To/Cc/Bcc replaced) and sent with the SMTP settings below.
# Recommended: start with it empty; set it to a test inbox you own later.
STAGING_EMAIL_REDIRECT=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=staging-noreply@krystartrust.ng

# ── Deliberately EMPTY on staging ───────────────────────────────────────────
# Staging never messages the directors' Telegram group and never calls the
# production Bank-Recon service. Keep these empty (docker-compose.staging.yml
# also forces them blank, and the deploy guard refuses a Telegram token).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BANK_RECON_SERVICE_URL=
INTERNAL_SERVICE_TOKEN=

# ── Demo data (manage.py seed_staging_demo) ─────────────────────────────────
# Optional. If unset, the seed generates passwords and prints them once.
# STAGING_DEMO_PASSWORD=
# Demo client emails are <name>@<this domain>. Use a domain you control or the
# reserved example.com, never a real mail provider.
# STAGING_DEMO_EMAIL_DOMAIN=example.com
