# Multi-stage build for React/Vite Frontend
FROM node:20.19-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
ENV NPM_CONFIG_PRODUCTION=false
RUN npm ci --include=dev

# Copy source code
COPY . .

# Build argument for API URL
ARG VITE_API_URL
ARG VITE_API_BASE_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Build arguments for brand white-labelling (all optional — see .env.example)
ARG VITE_BRAND_COMPANY_NAME
ARG VITE_BRAND_SHORT_NAME
ARG VITE_BRAND_MOTTO
ARG VITE_BRAND_TAGLINE
ARG VITE_BRAND_SYSTEM_LABEL
ARG VITE_BRAND_GOVT_APPROVED
ARG VITE_BRAND_LOGO_URL
ARG VITE_BRAND_BUILDING_IMAGE_URL
ARG VITE_BRAND_COLOR_NAVY_PRIMARY
ARG VITE_BRAND_COLOR_NAVY_DARK
ARG VITE_BRAND_COLOR_NAVY_LIGHT
ARG VITE_BRAND_COLOR_GOLD
ARG VITE_BRAND_COLOR_GOLD_LIGHT
ARG VITE_BRAND_COLOR_GOLD_DARK
ARG VITE_BRAND_COLOR_RED
ARG VITE_BRAND_COLOR_RED_LIGHT
ARG VITE_BRAND_COLOR_WHITE
ARG VITE_BRAND_COLOR_OFF_WHITE
ARG VITE_BRAND_COLOR_TEXT_PRIMARY
ARG VITE_BRAND_COLOR_TEXT_SECONDARY
ARG VITE_BRAND_COLOR_BORDER
ARG VITE_BRAND_ROLE_DIRECTOR_PRIMARY
ARG VITE_BRAND_ROLE_DIRECTOR_ACCENT
ARG VITE_BRAND_ROLE_PRINCIPAL_PRIMARY
ARG VITE_BRAND_ROLE_PRINCIPAL_ACCENT
ARG VITE_BRAND_ROLE_ADMINISTRATOR_PRIMARY
ARG VITE_BRAND_ROLE_ADMINISTRATOR_ACCENT
ARG VITE_BRAND_ROLE_REGISTRAR_PRIMARY
ARG VITE_BRAND_ROLE_REGISTRAR_ACCENT
ARG VITE_BRAND_ROLE_OFFICER_PRIMARY
ARG VITE_BRAND_ROLE_OFFICER_ACCENT
ENV VITE_BRAND_COMPANY_NAME=$VITE_BRAND_COMPANY_NAME
ENV VITE_BRAND_SHORT_NAME=$VITE_BRAND_SHORT_NAME
ENV VITE_BRAND_MOTTO=$VITE_BRAND_MOTTO
ENV VITE_BRAND_TAGLINE=$VITE_BRAND_TAGLINE
ENV VITE_BRAND_SYSTEM_LABEL=$VITE_BRAND_SYSTEM_LABEL
ENV VITE_BRAND_GOVT_APPROVED=$VITE_BRAND_GOVT_APPROVED
ENV VITE_BRAND_LOGO_URL=$VITE_BRAND_LOGO_URL
ENV VITE_BRAND_BUILDING_IMAGE_URL=$VITE_BRAND_BUILDING_IMAGE_URL
ENV VITE_BRAND_COLOR_NAVY_PRIMARY=$VITE_BRAND_COLOR_NAVY_PRIMARY
ENV VITE_BRAND_COLOR_NAVY_DARK=$VITE_BRAND_COLOR_NAVY_DARK
ENV VITE_BRAND_COLOR_NAVY_LIGHT=$VITE_BRAND_COLOR_NAVY_LIGHT
ENV VITE_BRAND_COLOR_GOLD=$VITE_BRAND_COLOR_GOLD
ENV VITE_BRAND_COLOR_GOLD_LIGHT=$VITE_BRAND_COLOR_GOLD_LIGHT
ENV VITE_BRAND_COLOR_GOLD_DARK=$VITE_BRAND_COLOR_GOLD_DARK
ENV VITE_BRAND_COLOR_RED=$VITE_BRAND_COLOR_RED
ENV VITE_BRAND_COLOR_RED_LIGHT=$VITE_BRAND_COLOR_RED_LIGHT
ENV VITE_BRAND_COLOR_WHITE=$VITE_BRAND_COLOR_WHITE
ENV VITE_BRAND_COLOR_OFF_WHITE=$VITE_BRAND_COLOR_OFF_WHITE
ENV VITE_BRAND_COLOR_TEXT_PRIMARY=$VITE_BRAND_COLOR_TEXT_PRIMARY
ENV VITE_BRAND_COLOR_TEXT_SECONDARY=$VITE_BRAND_COLOR_TEXT_SECONDARY
ENV VITE_BRAND_COLOR_BORDER=$VITE_BRAND_COLOR_BORDER
ENV VITE_BRAND_ROLE_DIRECTOR_PRIMARY=$VITE_BRAND_ROLE_DIRECTOR_PRIMARY
ENV VITE_BRAND_ROLE_DIRECTOR_ACCENT=$VITE_BRAND_ROLE_DIRECTOR_ACCENT
ENV VITE_BRAND_ROLE_PRINCIPAL_PRIMARY=$VITE_BRAND_ROLE_PRINCIPAL_PRIMARY
ENV VITE_BRAND_ROLE_PRINCIPAL_ACCENT=$VITE_BRAND_ROLE_PRINCIPAL_ACCENT
ENV VITE_BRAND_ROLE_ADMINISTRATOR_PRIMARY=$VITE_BRAND_ROLE_ADMINISTRATOR_PRIMARY
ENV VITE_BRAND_ROLE_ADMINISTRATOR_ACCENT=$VITE_BRAND_ROLE_ADMINISTRATOR_ACCENT
ENV VITE_BRAND_ROLE_REGISTRAR_PRIMARY=$VITE_BRAND_ROLE_REGISTRAR_PRIMARY
ENV VITE_BRAND_ROLE_REGISTRAR_ACCENT=$VITE_BRAND_ROLE_REGISTRAR_ACCENT
ENV VITE_BRAND_ROLE_OFFICER_PRIMARY=$VITE_BRAND_ROLE_OFFICER_PRIMARY
ENV VITE_BRAND_ROLE_OFFICER_ACCENT=$VITE_BRAND_ROLE_OFFICER_ACCENT

# Build the application
RUN npm run build

# Production stage with nginx
FROM nginx:alpine

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder (Vite builds to 'dist' directory by default)
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
RUN apk add --no-cache wget
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]