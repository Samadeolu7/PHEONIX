# Production Environment Variables
# The frontend communicates directly with the API host over CORS.
# The /api prefix is part of the URL (Django registers all routes under /api/).
VITE_API_BASE_URL=https://api.kti.krystartrust.ng/api
VITE_API_URL=https://api.kti.krystartrust.ng/api

# Authentication Configuration
VITE_USE_MOCK_AUTH=false

# Environment identifier
VITE_NODE_ENV=production

# Performance and Development Features
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_LOGGING=false

# Optional: Can be set by Vercel automatically
# VITE_APP_VERSION=$VERCEL_GIT_COMMIT_SHA
# VITE_VERCEL_URL=$VERCEL_URL

# Optional: Analytics or monitoring (uncomment and set if needed)
# VITE_ANALYTICS_ID=your-analytics-id
# VITE_SENTRY_DSN=your-sentry-dsn